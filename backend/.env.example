# API and database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/studio_beleza
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000
PORT=3333

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=replace-with-meta-access-token
PHONE_NUMBER_ID=replace-with-phone-number-id
OWNER_WHATSAPP_NUMBER=55DDDNUMERO
META_API_VERSION=v22.0
WHATSAPP_LANGUAGE_CODE=pt_BR

# Os modelos precisam estar aprovados na Meta. Nos modelos de confirmação, use:
# {{1}} nome da cliente, {{2}} WhatsApp, {{3}} serviço, {{4}} data e hora.
# No lembrete, use: {{1}} nome da cliente, {{2}} serviço, {{3}} data e hora,
# {{4}} endereço do Studio.
WHATSAPP_NEW_APPOINTMENT_TEMPLATE=novo_agendamento_studio
WHATSAPP_UPDATED_APPOINTMENT_TEMPLATE=agendamento_alterado_studio
WHATSAPP_REMINDER_TEMPLATE=lembrete_agendamento
STUDIO_ADDRESS=Endereço do Studio

# Conta administrativa inicial
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@studio.local
# Configure ADMIN_PASSWORD antes de criar uma conta administrativa em produção.
